{
  "name": "jarvis-ai-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android wrapper for the JARVIS AI HUD. The Python backend stays separate and is deployed independently over HTTPS.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "build:android": "npm run build && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:add": "node node_modules/@capacitor/cli/bin/capacitor add android",
    "cap:sync": "node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:doctor": "node node_modules/@capacitor/cli/bin/capacitor doctor",
    "assets": "node scripts/make-android-assets.mjs",
    "test:js": "node tests/frontend_smoke.mjs && node tests/no_lock_smoke.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "jsdom": "^27.0.0"
  }
}
