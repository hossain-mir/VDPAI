{
  "name": "vdpai",
  "version": "1.0.0",
  "private": true,
  "description": "VDPAI — private personal AI assistant with a local Android interface, provider configuration, native voice and conversation history.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "check": "node scripts/check-frontend.mjs",
    "test:js": "node tests/static_checks.mjs && node tests/hsai_smoke.mjs",
    "test": "npm run check && npm run test:js",
    "build:android": "npm run build && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:add": "node node_modules/@capacitor/cli/bin/capacitor add android",
    "cap:sync": "node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:doctor": "node node_modules/@capacitor/cli/bin/capacitor doctor",
    "assets": "node scripts/make-android-assets.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "jsdom": "^27.0.0"
  },
  "dependencies": {
    "@capacitor/preferences": "^8.0.1"
  }
}
